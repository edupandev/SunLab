{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth/google",
      "destination": "/api/auth/google"
    },
    {
      "source": "/api/products/:path*",
      "destination": "/api/products/index?path=:path*"
    },
    {
      "source": "/api/products",
      "destination": "/api/products/index"
    },
    {
      "source": "/((?!api/|auth/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
